        "ACT-001"
      ],
      "reqIds": [
        "REQ-003",
        "REQ-009",
        "REQ-011",
        "REQ-007"
      ]
    },
    {
      "id": "UC-005",
      "name": "Close auction",
      "description": "At end time the auction closes, winner is recorded or item marked unsold, watchers are informed.",
      "actorIds": [
        "ACT-003",
        "ACT-001"
      ],
      "reqIds": [
        "REQ-004",
        "REQ-003"
      ]
    },
    {
      "id": "UC-006",

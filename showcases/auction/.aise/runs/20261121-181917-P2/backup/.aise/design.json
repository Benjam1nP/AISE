      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-002",
        "REQ-009",
        "REQ-003",
        "REQ-011"
      ]
    },
    {
      "id": "UC-004",
      "name": "Watch item live",
      "description": "Client watches an item and receives bids, new end times and closing without reloading.",

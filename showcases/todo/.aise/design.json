{
  "actors": [
    {
      "id": "ACT-001",
      "name": "User",
      "description": "The single user of the task list, no login."
    }
  ],
  "useCases": [
    {
      "id": "UC-001",
      "name": "View task list",
      "description": "Open the app and see tasks, open first then done, oldest first in each group; due dates do not change the order. The Browser page shows each done task with a ticked checkbox and struck-through text, and each open task with an empty checkbox and plain text. A task with a due date shows the date next to its text. The page sends its local date as the today query parameter of GET /api/tasks and the server returns each task with an overdue flag (open, has a due date before today); the page marks tasks with overdue true. Done tasks and tasks without a due date are never overdue.",
      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-003",
        "REQ-004",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010"
      ]
    },
    {
      "id": "UC-002",
      "name": "Add task",
      "description": "Enter a description (trimmed, 1-200 chars) and optionally a due date (date only, YYYY-MM-DD) to add a not-done task. An invalid date or description creates no task.",
      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-001",
        "REQ-003",
        "REQ-009"
      ]
    },
    {
      "id": "UC-003",
      "name": "Mark task done or not done",
      "description": "Tick or untick a task. The Browser page sends PATCH /api/tasks/:id with done true or false, then re-renders that task from the returned Task: done shows a ticked checkbox and struck-through text, not done shows an empty checkbox and plain text, so the two states look different. The task moves to its place in the open or done group. Unticking a task with a past due date marks it overdue; the page reloads the list with its local date so the server's overdue flag is current.",
      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-002",
        "REQ-003",
        "REQ-007",
        "REQ-010"
      ]
    },
    {
      "id": "UC-004",
      "name": "Edit task",
      "description": "Change the text and the optional due date of a task with the same rules as adding. The due date can be set, changed or cleared. An invalid text or date is rejected and the stored values are kept; the done state is kept.",
      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-005",
        "REQ-003",
        "REQ-009"
      ]
    },
    {
      "id": "UC-005",
      "name": "Delete task",
      "description": "Remove a task permanently.",
      "actorIds": [
        "ACT-001"
      ],
      "reqIds": [
        "REQ-006",
        "REQ-003"
      ]
    }
  ],

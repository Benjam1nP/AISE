{
	"name": "aise",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.9"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project node --project jsdom",
		"test:docker": "vitest run --project docker --no-file-parallelism",
		"mcp": "tsx src/lib/server/mcp/main.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/client": "^2.4.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.4.0",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.68.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"codemirror": "^6.0.2",
		"diff": "^9.0.0",
		"mermaid": "^12.3.0",
		"thinking-orbs": "^0.3.2",
		"ts-morph": "^28.0.0",
		"typescript": "^6.0.3",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}

# runtime SQLite files of a showcase run
/showcases/*/data/
# presentation template, copied in locally
/presentation/template/

# course slides (instructor material, docs/context has the Markdown); our own slides go in presentation/
/docs/pdf/slides/
# third party agent skills and their lockfile, local only (install with `npx skills add`)
/.claude/skills/
/.agents/
/skills-lock.json
